# Copie para .env.local e preencha. O .env.local nunca vai para o git.

# --- Voz do servidor (POST /api/voz) -------------------------------------
# Recurso "Speech" no portal do Azure: Chaves e Ponto de extremidade.
# Sem a chave, as jornadas usam a voz do próprio aparelho.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# Opcional: URL completa do serviço, no lugar da região.
# AZURE_SPEECH_ENDPOINT=https://brazilsouth.tts.speech.microsoft.com/cognitiveservices/v1

# Opcional: onde guardar os áudios gerados (padrão: .cache/voz).
# Em hospedagem com disco somente leitura, use uma pasta gravável, ex.: /tmp/voz
# VOZ_CACHE_DIR=

# --- API mock (json-server) ----------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:3333
